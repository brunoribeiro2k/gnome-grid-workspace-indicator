<?xml version="1.0" encoding="UTF-8"?>
<interface domain="gsi@fett2k.com">
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>

  <object class="AdwPreferencesPage" id="main_widget">
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Appearance</property>
        <child>
          <object class="AdwActionRow" id="row_cells">
            <property name="title" translatable="yes">Cells</property>
            <child>
              <object class="GtkBox">
                <property name="spacing">12</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkScale" id="cell_size_scale">
                    <property name="orientation">horizontal</property>
                    <property name="width-request">150</property>
                    <property name="valign">center</property>
                    <property name="digits">0</property>
                    <property name="draw-value">true</property>
                    <property name="value-pos">right</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">50</property>
                        <property name="upper">100</property>
                        <property name="value">75</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkDropDown" id="cell_shape_dropdown">
                    <property name="valign">center</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">Circle</item>
                          <item translatable="yes">Square</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Colors</property>
        <child>
          <object class="AdwActionRow" id="row_active_fill">
            <property name="title" translatable="yes">Active workspace</property>
            <child>
              <object class="GtkColorDialogButton" id="active_fill_button">
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="dialog">
                  <object class="GtkColorDialog">
                    <property name="title" translatable="yes">Active fill color</property>
                    <property name="with-alpha">true</property>
                  </object>
                </property>
                <style>
                  <class name="color-button"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="row_inactive_fill">
            <property name="title" translatable="yes">Other workspaces</property>
            <child>
              <object class="GtkColorDialogButton" id="inactive_fill_button">
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="dialog">
                  <object class="GtkColorDialog">
                    <property name="title" translatable="yes">Inactive fill color</property>
                    <property name="with-alpha">true</property>
                  </object>
                </property>
                <style>
                  <class name="color-button"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Outline and logging</property>
        <child>
          <object class="AdwActionRow" id="row_outline">
            <property name="title" translatable="yes">Outline</property>
            <property name="subtitle" translatable="yes">For workspaces with open apps</property>
            <child>
              <object class="GtkBox">
                <property name="spacing">12</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkSpinButton" id="outline_thickness_scale">
                    <property name="orientation">horizontal</property>
                    <property name="width-request">150</property>
                    <property name="valign">center</property>
                    <property name="numeric">true</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">0</property>
                        <property name="upper">3</property>
                        <property name="value">1</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">1</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkColorDialogButton" id="outline_color_button">
                    <property name="valign">center</property>
                    <property name="width-request">32</property>
                    <property name="dialog">
                      <object class="GtkColorDialog">
                        <property name="title" translatable="yes">Outline color</property>
                        <property name="with-alpha">true</property>
                      </object>
                    </property>
                    <style>
                      <class name="color-button"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="row_outline_active">
            <property name="title" translatable="yes">Apply outline to active workspace</property>
            <child>
              <object class="GtkSwitch" id="outline_active_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="row_debug_logging">
            <property name="title" translatable="yes">Enable debug logging</property>
            <property name="subtitle" translatable="yes">Write extra logs to the journal.</property>
            <child>
              <object class="GtkSwitch" id="debug_logging_switch">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesGroup">
        <child>
          <object class="GtkButton" id="reset_button">
            <property name="label" translatable="yes">Reset all settings</property>
            <property name="margin-top">12</property>
            <style>
              <class name="destructive-action"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="build_label">
            <property name="margin-top">12</property>
            <property name="selectable">true</property>
            <style>
              <class name="dim-label"/>
              <class name="caption"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
